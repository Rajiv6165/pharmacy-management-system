DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/pharmacy_db
POSTGRES_PASSWORD=your_postgres_password_here
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
RAZORPAY_SECRET=your_razorpay_secret_key_here
ADMIN_BOOTSTRAP_PASSWORD=your_admin_bootstrap_password_here

# Phase 3 Env Setup
ENV=local # local | staging | production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AWS S3 (Leave empty to default to local static files storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Razorpay Webhooks
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Sentry DSN
SENTRY_DSN=your_sentry_dsn

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_from_number

# SMTP Email (Low stock alert)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=alerts@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
BRAND_NAME=Pharmacy
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
